DATABASE_URL="postgresql://lundro:lundro@localhost:5432/lundro?schema=public"
# Direct connection used by migrations (Supabase: db.<ref>.supabase.co, port 5432). Same as DATABASE_URL locally.
DIRECT_URL="postgresql://lundro:lundro@localhost:5432/lundro?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
